root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Test names follow the rule-referencing convention (e.g. R2_Cannot_edit_sent_quote, PLAN §7),
# which CA1707 (no underscores in identifiers) would reject. Scoped to tests only.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
